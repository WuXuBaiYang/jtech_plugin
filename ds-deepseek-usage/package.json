{
  "name": "ds-deepseek-usage",
  "version": "1.0.0",
  "description": "DeepSeek account usage monitor (HP/MP) — sidebar module with balance and token usage bars, browser-login auth capture, hourly visible-only sync, and real-time local token increments.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "usage",
    "token",
    "balance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuXuBaiYang/jtech_plugin.git",
    "directory": "ds-deepseek-usage"
  },
  "homepage": "https://github.com/WuXuBaiYang/jtech_plugin/tree/master/ds-deepseek-usage",
  "bugs": {
    "url": "https://github.com/WuXuBaiYang/jtech_plugin/issues"
  },
  "author": {
    "name": "WuXuBaiYang",
    "email": "3906549+WuXuBaiYang@users.noreply.github.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
